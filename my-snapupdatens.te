
module my-snapupdatens 1.0;

require {
	type kdump_etc_t;
	type shadow_t;
	type rsync_etc_t;
	type krb5_conf_t;
	type syslog_conf_t;
	type firewalld_etc_rw_t;
	type cert_t;
	type mdevctl_conf_t;
	type rhsmcertd_config_t;
	type bluetooth_conf_t;
	type samba_etc_t;
	type xdm_etc_t;
	type dnsmasq_etc_t;
	type dbusd_etc_t;
	type cupsd_rw_etc_t;
	type passwd_file_t;
	type pdns_conf_t;
	type snappy_mount_t;
	type lircd_etc_t;
	type abrt_etc_t;
	type named_conf_t;
	type snapperd_conf_t;
	type mcelog_etc_t;
	type net_conf_t;
	type ipsec_key_file_t;
	type NetworkManager_etc_t;
	type sssd_conf_t;
	type openvpn_etc_t;
	type hostname_etc_t;
	type mysqld_etc_t;
	type etc_aliases_t;
	type system_cron_spool_t;
	type httpd_config_t;
	type adjtime_t;
	type etc_mail_t;
	type dhcp_etc_t;
	type cupsd_etc_t;
	type tuned_etc_t;
	type auditd_etc_t;
	type exports_t;
	type pppd_etc_t;
	type vmtools_unconfined_exec_t;
	type snappy_var_t;
	type avahi_conf_t;
	type ipsec_conf_file_t;
	type squid_conf_t;
	type modules_conf_t;
	type virt_etc_t;
	type dirsrv_config_t;
	type lvm_etc_t;
	class dir { add_name create getattr read setattr write };
	class file { create getattr open read setattr };
	class lnk_file read;
}

#============= snappy_mount_t ==============
allow snappy_mount_t NetworkManager_etc_t:dir getattr;
allow snappy_mount_t abrt_etc_t:dir getattr;
